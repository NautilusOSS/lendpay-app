# Copy to .env — Vite exposes only variables prefixed with VITE_

# Build / SEO — canonical origin (no trailing slash)
# VITE_SITE_URL=https://lendpay.app

# WalletConnect Cloud (recommended for any non-local build)
# VITE_WC_PROJECT_ID=

# Optional — Base JSON-RPC for x402 / viem
# VITE_BASE_MAINNET_RPC_URL=

# Gateway HTTP API. In dev, leave unset to use same-origin /gateway (Vite proxy).
# VITE_GATEWAY_BASE_URL=https://your-api.example.com

# Dev proxy target for /gateway (vite.config.ts)
# VITE_GATEWAY_PROXY_TARGET=http://127.0.0.1:3001

# Optional — execute step UI / gateway auth
# VITE_GATEWAY_PAY_USD=
# VITE_GATEWAY_API_TOKEN=

# Local synthetic x402 v2 helper (see src/lib/x402.ts)
# VITE_LOCAL_OPEN_AGENT_X402_PAY_TO=0x0000000000000000000000000000000000000000
# VITE_LOCAL_OPEN_AGENT_X402_AMOUNT=1000000
